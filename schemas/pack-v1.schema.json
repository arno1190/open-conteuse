{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arno1190/open-conteuse/schemas/pack-v1.schema.json",
  "title": "Open Conteuse pack v1",
  "type": "object",
  "required": ["format_version", "id", "title", "start", "nodes"],
  "properties": {
    "format_version": {"const": 1, "type": "integer"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "start": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "audio": {"type": "string", "minLength": 1},
        "choices": {"type": "array", "items": {
          "type": "object", "required": ["label", "target"],
          "properties": {"label": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}
        }}
      }
    }},
    "assets": {"type": "array", "items": {
      "type": "object", "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }}
  }
}
